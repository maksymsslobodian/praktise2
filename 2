DAYS = ["Понеділок", "Вівторок", "Середа", "Четвер", "П'ятниця"]

def analyze_schedule(schedule, group_idx=0):
    print(f"\nАналіз розкладу для групи {group_idx + 1}:")
    
    
    max_pairs = -1
    busiest_day = ""
    for day_i, day_name in enumerate(DAYS):
        count = sum(1 for pair in schedule[group_idx][day_i] if pair != "Вільне вікно")
        if count > max_pairs:
            max_pairs = count
            busiest_day = day_name
    print(f"1. Найбільш завантажений день: {busiest_day} ({max_pairs} пар(и))")

    
    window_days = []
    for day_i, day_name in enumerate(DAYS):
        day_lessons = schedule[group_idx][day_i]
        active_indices = [i for i, lesson in enumerate(day_lessons) if lesson != "Вільне вікно"]
        if len(active_indices) > 1:
            for i in range(len(active_indices) - 1):
                if active_indices[i+1] - active_indices[i] > 1:
                    window_days.append(day_name)
                    break
    print(f"2. Дні з незручним розкладом: {', '.join(window_days) if window_days else 'Немає'}")

    print("3. Потокові заняття:")
    found_streams = False
    for day_i, day_name in enumerate(DAYS):
        for pair_i in range(4):
            subjects_at_time = {}
            for g_i in range(3):
                subj = schedule[g_i][day_i][pair_i]
                if subj != "Вільне вікно":
                    subjects_at_time.setdefault(subj, []).append(g_i + 1)
            
            for subj, groups in subjects_at_time.items():
                if len(groups) > 1:
                    found_streams = True
                    print(f"   • {day_name}, {pair_i + 1}-я пара: '{subj}' у груп {groups}")
    if not found_streams:
        print("   • Потокових занять не знайдено.")


