import random

def generate_matrix(m, n, min_val=0, max_val=10):
    """Генерує двовимірний масив (матрицю) розміром m x n."""
    return [[random.randint(min_val, max_val) for _ in range(n)] for _ in range(m)]


def print_matrix(matrix, title="Матриця"):
    """Виводить матрицю з підписами стовпців та рядків."""
    print(f"\n--- {title} ---")
    if not matrix or not matrix[0]:
        print("Порожня матриця")
        return
    
    m = len(matrix)
    n = len(matrix[0])
    
    headers = [""] + [f"стовпець {j+1}" for j in range(n)]
    print("\t".join(headers))
    
    for i in range(m):
        row_str = [f"рядок {i+1}"]
        for val in matrix[i]:
            if isinstance(val, float):
                row_str.append(f"{val:8.2f}")
            else:
                row_str.append(f"{val:8}")
        print("\t".join(row_str))


# 1.
def task1_subtract_mean(matrix):
    result = []
    for row in matrix:
        mean = sum(row) / len(row)
        result.append([round(x - mean, 2) for x in row])
    return result


# 2.
def task2_cyclic_shift(matrix, k):
    m, n = len(matrix), len(matrix[0])
    k_up = k % m
    k_right = k % n
    
    shifted_up = matrix[k_up:] + matrix[:k_up]
    shifted_final = []
    for row in shifted_up:
        new_row = row[-k_right:] + row[:-k_right]
        shifted_final.append(new_row)
        
    return shifted_final


# 3. 
def task3_remove_max(matrix):
    max_val = max(max(row) for row in matrix)
    m, n = len(matrix), len(matrix[0])
    
    bad_rows, bad_cols = set(), set()
    for i in range(m):
        for j in range(n):
            if matrix[i][j] == max_val:
                bad_rows.add(i)
                bad_cols.add(j)
                
    new_matrix = [
        [matrix[i][j] for j in range(n) if j not in bad_cols]
        for i in range(m) if i not in bad_rows
    ]
    return new_matrix, max_val


# 4. 
def task4_rotate_90_inplace(matrix):
    n = len(matrix)
    for i in range(n):
        for j in range(i + 1, n):
            matrix[i][j], matrix[j][i] = matrix[j][i], matrix[i][j]
            
    for i in range(n):
        matrix[i].reverse()


